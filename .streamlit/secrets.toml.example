# Streamlit Secrets 設定範例
# 複製此檔案並命名為 secrets.toml，或直接填寫至 secrets.toml 中
# 也可在 Streamlit Cloud 的專案 Settings -> Secrets 中貼上以下內容

# Google Gemini API 金鑰 (免費申請: https://aistudio.google.com/)
GEMINI_API_KEY = "你的_GEMINI_API_KEY"

# Groq API 金鑰 (免費申請: https://console.groq.com/keys)
GROQ_API_KEY = "你的_GROQ_API_KEY"
